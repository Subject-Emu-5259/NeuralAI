# NeuralAI remote browser offload config
# Copy these into the neuralai-web-ui service env vars (or export locally).

# local  = launch Chromium inside this Zo container (default)
# remote = connect Playwright to an external CDP/WSE endpoint (no local Chrome)
NEURALAI_BROWSER_MODE=remote

# Option A: CDP WebSocket URL (Browserbase, Bright Data, self-hosted Chrome, etc.)
# Examples:
#   Browserbase: wss://connect.browserbase.com/v1/sessions/<session-id>?apiKey=<key>
#   Self-hosted Chrome: ws://my-vps.example.com:9222/devtools/browser/<id>
NEURALAI_REMOTE_BROWSER_CDP_URL=wss://example.com/cdp

# Option B: Playwright WSE URL (some providers expose this instead of CDP)
# If CDP_URL is set, it takes precedence.
# NEURALAI_REMOTE_BROWSER_WSE_URL=wss://example.com/playwright

# When local mode is used, each /browse call now auto-closes its browser so
# sessions don't accumulate. Set keep_session=true in the tool call if you
# really need reuse.
