            "source": [
                "# 🧪 NeuralAI Calibration Training Notebook\n",
                "\n",
                "This notebook is used to perform aggressive calibration passes on NeuralAI models to resolve pathological token biases (e.g., newline saturation, 'system' loops, or 'helpful' repetition).\n",
                "\n",
                "## Purpose\n",
                "To shift probability mass from biased tokens to semantically valid candidates in the top-N logits using specialized loss functions or weight intervention strategies."
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 1. Setup and Environment\n",
                "Ensure `torch`, `transformers`, and `peft` are installed. Load the base model and the target configuration."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "import torch\n",
                "from transformers import AutoModelForCausalLM, AutoTokenizer\n",
                "import json\n",
                "\n",
                "# Load configuration\n",
                "CONFIG_PATH = \"/home/workspace/Projects/NeuralAI/infrastructure/configs/neuralai_3b_core.json\"\n",
                "with open(CONFIG_PATH, 'r') as f:\n",
                "    config = json.load(f)\n",
                "\n",
                "print(f\"Target Model: {config['model_name']}\")\n",
                "print(f\"Architecture: {config['architecture']}\")\n"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 2. Logit Analysis & Bias Identification\n",
                "Analyze the output head to find tokens with disproportionately high probabilities."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "def analyze_logits(model, tokenizer, input_text):\n",
                "    inputs = tokenizer(input_text, return_tensors='pt').to(model.device)\n",
                "    with torch.no_grad():\n",
                "        logits = model(**inputs).logits\n",
                "    \n",
                "    last_token_logits = logits[0, -1, :]\n",
                "    probs = torch.softmax(last_token_logits, dim=-1)\n",
                "    top_k = torch.topk(probs, 15)\n",
                "    \n",
                "    print(\"Top-15 Probabilities:\")\n",
                "    for i in range(15):\n",
                "        token_id = top_k.indices[i].item()\n",
                "        prob = top_k.values[i].item()\n",
                "        token_str = tokenizer.decode([token_id])\n",
                "        print(f\"{i+1}. {token_str} (ID: {token_id}): {prob:.4f}\")\n",
                "\n",
                "# Example usage\n",
                "# analyze_logits(model, tokenizer, \"Hello, how are you?\")"
            ]
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 3. Surgical Weight Intervention\n",
                "Manually suppress biased tokens by zeroing or dampening their weights in the `lm_head`."
            ]
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "def apply_surgical_suppression(model, token_ids, factor=100.0):\n",
                "    \"\"\"\n",
                "    Reduces the influence of specific token IDs in the output head.\n",
                "    \"\"\"\n",
                "    with torch.no_grad():\n",
                "        # Access the lm_head weights\n",
                "        # Note: This assumes standard Transformers architecture\n",
                "        lm_head = model.get_output_embeddings()\n",
                "        for tid in token_ids:\n",
                "            lm_head.weight[tid] *= (1.0 / factor)\n",
                "            print(f\"Suppressed token ID {tid}\")\n",
                "\n",
                "# Example usage\n",
                "# apply_surgical_suppression(model, [198, 9690], factor=100.0)"
            ]
        },
